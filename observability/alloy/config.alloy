local.file_match "frr" {
  path_targets = [{"__path__" = "/logs/*/frr.log", "job" = "frr"}]
}

// turn /logs/leaf1/frr.log into node="leaf1"
discovery.relabel "frr" {
  targets = local.file_match.frr.targets
  rule {
    source_labels = ["__path__"]
    regex         = "/logs/([^/]+)/frr.log"
    target_label  = "node"
  }
}

loki.source.file "frr" {
  targets    = discovery.relabel.frr.output
  forward_to = [loki.process.frr.receiver]
}

loki.process "frr" {
  stage.regex {
    expression = `^(?P<ts>\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2}\.\d{3}) (?P<daemon>[A-Z]+):`
  }
  stage.timestamp {
    source   = "ts"
    format   = "2006/01/02 15:04:05.000"
    location = "UTC"
  }
  stage.labels {
    values = { daemon = "" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
