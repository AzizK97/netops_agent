{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "fabric-overview"
  },
  "spec": {
    "title": "Fabric Overview",
    "description": "Leaf-spine fabric: BGP health, link traffic, FRR logs.",
    "tags": [
      "fabric",
      "bgp",
      "frr"
    ],
    "editable": true,
    "cursorSync": "Crosshair",
    "liveNow": false,
    "preload": false,
    "links": [],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "elements": {
      "s-established": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "BGP sessions established",
          "description": "Share of BGP sessions in Established state. Anything below 100% means a session is down.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "count(frr_bgp_peer_state{node=~\"$node\"} == 1) / count(frr_bgp_peer_state{node=~\"$node\"})",
                        "legendFormat": "__auto",
                        "editorMode": "code",
                        "range": false,
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.4",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "red"
                      },
                      {
                        "value": 0.999,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "s-down": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Sessions not established",
          "description": "BGP sessions whose state is not 1 (Established).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "count(frr_bgp_peer_state{node=~\"$node\"} != 1) or vector(0)",
                        "legendFormat": "__auto",
                        "editorMode": "code",
                        "range": false,
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.4",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "s-flaps": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Session resets (time range)",
          "description": "How many times a BGP session's uptime counter went back to zero within the selected time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "sum(resets(frr_bgp_peer_uptime_seconds{node=~\"$node\"}[$__range])) or vector(0)",
                        "legendFormat": "__auto",
                        "editorMode": "code",
                        "range": false,
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.4",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "orange"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "s-ports": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Fabric ports down",
          "description": "Leaf uplinks (eth1-2) and spine downlinks (eth1-4) that are operationally down. A single broken link shows up as 2 (one per end).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "count((node_network_up{role=\"leaf\", device=~\"eth[12]\", node=~\"$node\"} or node_network_up{role=\"spine\", device=~\"eth[1-4]\", node=~\"$node\"}) == 0) or vector(0)",
                        "legendFormat": "__auto",
                        "editorMode": "code",
                        "range": false,
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.4",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "s-targets": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Scrape targets down",
          "description": "Exporters Prometheus cannot reach (job frr + node).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "count(up{node=~\"$node\"} == 0) or vector(0)",
                        "legendFormat": "__auto",
                        "editorMode": "code",
                        "range": false,
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.4",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "s-adj": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "ADJCHANGE log events (time range)",
          "description": "FRR log lines containing ADJCHANGE (BGP neighbor up/down) within the selected time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "expr": "sum(count_over_time({job=\"frr\", node=~\"$node\"} |= \"ADJCHANGE\" [$__range])) or vector(0)",
                        "legendFormat": "__auto",
                        "editorMode": "code",
                        "queryType": "instant"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.4",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "orange"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "bgp-state": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "BGP session state",
          "description": "One row per session, seen from each router. Red bars line up with flaps on the other panels.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "frr_bgp_peer_state{node=~\"$node\"}",
                        "legendFormat": "{{node}} \u2192 {{peer}} (AS{{peer_as}})",
                        "editorMode": "code",
                        "range": true,
                        "instant": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "state-timeline",
            "version": "13.2.4",
            "spec": {
              "options": {
                "mergeValues": true,
                "showValue": "never",
                "rowHeight": 0.8,
                "alignValue": "left",
                "legend": {
                  "showLegend": false,
                  "displayMode": "list",
                  "placement": "bottom"
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "1": {
                          "text": "UP",
                          "color": "green",
                          "index": 0
                        },
                        "0": {
                          "text": "DOWN",
                          "color": "red",
                          "index": 1
                        },
                        "2": {
                          "text": "ADMIN DOWN",
                          "color": "orange",
                          "index": 2
                        }
                      }
                    }
                  ],
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "red"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  },
                  "custom": {
                    "fillOpacity": 80,
                    "lineWidth": 0
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "bgp-pfx": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Prefixes received per session",
          "description": "Prefixes each router accepted from each neighbor. A drop to 0 = the neighbor withdrew everything or the session died.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "frr_bgp_peer_prefixes_received_count_total{node=~\"$node\"}",
                        "legendFormat": "{{node}} \u2190 {{peer}}",
                        "editorMode": "code",
                        "range": true,
                        "instant": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.4",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "sortBy": "lastNotNull",
                  "sortDesc": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "min": 0,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineWidth": 2,
                    "fillOpacity": 10,
                    "showPoints": "never",
                    "lineInterpolation": "stepAfter",
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "spanNulls": false
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "rib": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "IPv4 routes in RIB per node",
          "description": "Total IPv4 routes per router. Convergence after a failure shows up as a dip and recovery.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "frr_route_total{afi=\"ipv4\", node=~\"$node\"}",
                        "legendFormat": "{{node}}",
                        "editorMode": "code",
                        "range": true,
                        "instant": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.4",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "calcs": [
                    "lastNotNull",
                    "min"
                  ],
                  "sortBy": "min",
                  "sortDesc": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "min": 0,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineWidth": 2,
                    "fillOpacity": 10,
                    "showPoints": "never",
                    "lineInterpolation": "stepAfter",
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "spanNulls": false
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "thru": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Fabric link throughput (above 0: leaf \u2192 spine, below 0: spine \u2192 leaf)",
          "description": "Measured on the leaf side of each of the 8 leaf-spine links, so every link appears exactly once.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "label_replace(rate(node_network_transmit_bytes_total{role=\"leaf\", device=~\"eth[12]\", node=~\"$node\"}[$__rate_interval]) * 8, \"spine\", \"spine$1\", \"device\", \"eth(.)\")",
                        "legendFormat": "{{node}} \u2192 {{spine}}",
                        "editorMode": "code",
                        "range": true,
                        "instant": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "label_replace(rate(node_network_receive_bytes_total{role=\"leaf\", device=~\"eth[12]\", node=~\"$node\"}[$__rate_interval]) * 8, \"spine\", \"spine$1\", \"device\", \"eth(.)\")",
                        "legendFormat": "{{node}} \u2190 {{spine}}",
                        "editorMode": "code",
                        "range": true,
                        "instant": false
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.4",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "calcs": [
                    "mean",
                    "max"
                  ],
                  "sortBy": "max",
                  "sortDesc": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bps",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineWidth": 2,
                    "fillOpacity": 15,
                    "showPoints": "never",
                    "lineInterpolation": "smooth",
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "spanNulls": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byFrameRefID",
                      "options": "B"
                    },
                    "properties": [
                      {
                        "id": "custom.transform",
                        "value": "negative-Y"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "ports": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Fabric port state",
          "description": "Operational state of every fabric-facing interface (host ports and eth0 management are excluded).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "node_network_up{role=\"leaf\", device=~\"eth[12]\", node=~\"$node\"} or node_network_up{role=\"spine\", device=~\"eth[1-4]\", node=~\"$node\"}",
                        "legendFormat": "{{node}} {{device}}",
                        "editorMode": "code",
                        "range": true,
                        "instant": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "state-timeline",
            "version": "13.2.4",
            "spec": {
              "options": {
                "mergeValues": true,
                "showValue": "never",
                "rowHeight": 0.8,
                "alignValue": "left",
                "legend": {
                  "showLegend": false,
                  "displayMode": "list",
                  "placement": "bottom"
                },
                "tooltip": {
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "1": {
                          "text": "UP",
                          "color": "green",
                          "index": 0
                        },
                        "0": {
                          "text": "DOWN",
                          "color": "red",
                          "index": 1
                        },
                        "2": {
                          "text": "ADMIN DOWN",
                          "color": "orange",
                          "index": 2
                        }
                      }
                    }
                  ],
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "red"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  },
                  "custom": {
                    "fillOpacity": 80,
                    "lineWidth": 0
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "drops": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "Drops + errors per interface",
          "description": "rx/tx drops and errors summed per interface. Should be flat at 0; host ports included.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prom"
                      },
                      "spec": {
                        "expr": "sum by (node, device) (rate(node_network_receive_drop_total{device=~\"eth[1-4]\", node=~\"$node\"}[$__rate_interval]) + rate(node_network_transmit_drop_total{device=~\"eth[1-4]\", node=~\"$node\"}[$__rate_interval]) + rate(node_network_receive_errs_total{device=~\"eth[1-4]\", node=~\"$node\"}[$__rate_interval]) + rate(node_network_transmit_errs_total{device=~\"eth[1-4]\", node=~\"$node\"}[$__rate_interval]))",
                        "legendFormat": "{{node}} {{device}}",
                        "editorMode": "code",
                        "range": true,
                        "instant": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.4",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "calcs": [
                    "max"
                  ],
                  "sortBy": "max",
                  "sortDesc": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "pps",
                  "min": 0,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineWidth": 2,
                    "fillOpacity": 10,
                    "showPoints": "never",
                    "lineInterpolation": "stepAfter",
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "spanNulls": false
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "logvol": {
        "kind": "Panel",
        "spec": {
          "id": 13,
          "title": "FRR log volume per node",
          "description": "Log lines per node. Spikes usually match session flaps.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "expr": "sum by (node) (count_over_time({job=\"frr\", node=~\"$node\"} [$__auto]))",
                        "legendFormat": "{{node}}",
                        "editorMode": "code",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.4",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "calcs": [
                    "sum"
                  ],
                  "sortBy": "sum",
                  "sortDesc": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "min": 0,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "bars",
                    "lineWidth": 2,
                    "fillOpacity": 80,
                    "showPoints": "never",
                    "lineInterpolation": "linear",
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    },
                    "spanNulls": false
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
